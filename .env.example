# Without DATABASE_URL, a NEW local data/iapolleras.db is created.
# To keep the existing MySQL catalogue, configure its URL before starting.
# Use a dedicated database user with a password, not root.
# DATABASE_URL=mysql+pymysql://iapolleras:URL_ENCODED_PASSWORD@127.0.0.1/iapollera
# To use the old SQLite file explicitly:
# DATABASE_URL=sqlite:///D:/StartUp2026/IAPolleras/sql_app.db

# Local development generates a persistent key under data/.session-key.
# Production requires your own random key (minimum 32 characters) and HTTPS.
# SECRET_KEY=
PRODUCTION=false
COOKIE_SECURE=false
SESSION_MINUTES=60
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=20
TTS_TIMEOUT=15
VOICE_EDGE=es-MX-DaliaNeural
# PIPER_BIN=piper
# PIPER_MODEL=D:/models/es_ES-davefx-medium.onnx
WHATSAPP_NUMBER=51974342536
CAMERA_INDEX=1
CAMERA_FPS=8
